# Copy this to .env and fill in the values from your JaaS dashboard.
# Keep the real file out of version control.
JAAS_APP_ID=your-jaas-app-id
JAAS_KID=your-jaas-key-id
# Paste the entire private key, with real newlines or escaped \n sequences.
JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
PASTE_YOUR_PRIVATE_KEY_HERE
-----END PRIVATE KEY-----
"
